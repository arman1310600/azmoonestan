generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- نقش‌ها: STUDENT | COUNCIL | STAFF | ADMIN ----------

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  fullName     String
  role         String   @default("STUDENT")
  gradeId      String?
  classId      String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  grade       SchoolClass?  @relation("StudentClass", fields: [classId], references: [id], onDelete: SetNull)
  reports     Report[]      @relation("Reporter")
  notes       ReportNote[]
  messages    ReportMessage[]
  histories   ReportHistory[]
  announcements Announcement[]
  azSchedules AzSchedule[]
  azApiKeysCreated AzApiKey[] @relation("AzApiKeyCreator")
}

model Grade {
  id    String @id @default(cuid())
  name  String @unique
  order Int    @default(0)

  classes SchoolClass[]
  reports Report[]
}

model SchoolClass {
  id      String @id @default(cuid())
  name    String
  gradeId String

  grade    Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  students User[]   @relation("StudentClass")
  reports  Report[]
}

model Subject {
  id     String  @id @default(cuid())
  name   String  @unique
  active Boolean @default(true)

  teachers TeacherSubject[]
  reports  Report[]
}

model Teacher {
  id       String  @id @default(cuid())
  fullName String
  active   Boolean @default(true)

  subjects    TeacherSubject[]
  reports     Report[]
}

model TeacherSubject {
  teacherId String
  subjectId String

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([teacherId, subjectId])
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  description String  @default("")
  icon        String  @default("message-circle")
  order       Int     @default(0)
  active      Boolean @default(true)

  reports Report[]
}

model Report {
  id            String   @id @default(cuid())
  code          String   @unique
  reporterId    String?
  isConfidential Boolean @default(false)
  categoryId    String
  gradeId       String?
  classId       String?
  subjectId     String?
  teacherId     String?
  incidentDate  String?
  title         String
  description   String
  impact        String?
  suggestion    String?
  status        String   @default("SUBMITTED")
  priority      String   @default("NORMAL")
  safetyFlag    Boolean  @default(false)
  flaggedAbuse  Boolean  @default(false)
  withdrawnAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  firstReviewedAt DateTime?
  respondedAt   DateTime?
  closedAt      DateTime?

  reporter    User?          @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  category    Category       @relation(fields: [categoryId], references: [id])
  grade       Grade?         @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  schoolClass SchoolClass?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  subject     Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacher     Teacher?       @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  attachments Attachment[]
  notes       ReportNote[]
  messages    ReportMessage[]
  histories   ReportHistory[]
}

model Attachment {
  id           String   @id @default(cuid())
  reportId     String
  originalName String
  storedName   String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

// یادداشت داخلی — دانش‌آموز نمی‌بیند
model ReportNote {
  id        String   @id @default(cuid())
  reportId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

// پیام بین بررسی‌کننده و دانش‌آموز (درخواست توضیح / پاسخ)
model ReportMessage {
  id        String   @id @default(cuid())
  reportId  String
  authorId  String
  type      String   // INFO_REQUEST | RESPONSE | STUDENT_REPLY
  body      String
  seenByStudent Boolean @default(false)
  seenByCouncil Boolean @default(false)
  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model ReportHistory {
  id         String   @id @default(cuid())
  reportId   String
  actorId    String?
  actorName  String   @default("سیستم")
  action     String
  fromStatus String?
  toStatus   String?
  detail     String?
  createdAt  DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  published Boolean  @default(true)
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String?
  entityId  String?
  detail    String?
  ip        String?
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

// کلیدهای API داخلی آزمونستان (§۶) — کلید خام هرگز ذخیره نمی‌شود؛ فقط هش bcrypt
// scopes: رشتهٔ جداشده با «,» یا آرایهٔ JSON — هر دو شکل در api-keys.ts پارس می‌شود
model AzApiKey {
  id           String    @id @default(cuid())
  name         String
  prefix       String    @unique // ۱۲ نویسهٔ اول کلید — برای شناسایی سریع
  keyHash      String // bcrypt از کلید خام
  scopes       String    @default("read") // read | write | admin (تک‌دامنه یا لیست)
  rateLimitMin Int       @default(60) // سقف فراخوانی در دقیقه
  useCount     Int       @default(0)
  lastUsedAt   DateTime?
  expiresAt    DateTime?
  revokedAt    DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())

  createdBy User? @relation("AzApiKeyCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([prefix])
}

// ============================================================
// آزمونستان AI — مدل‌های اختصاصی (دورهٔ دوم: پایه ۱۰ تا ۱۲)
// ============================================================

// زمان‌بندی تکرارشوندهٔ مأموریت‌های ایجنت (روزانه/هفتگی به وقت تهران)
model AzSchedule {
  id          String    @id @default(cuid())
  name        String
  enabled     Boolean   @default(true)
  cadence     String    @default("DAILY") // DAILY | WEEKLY
  timeOfDay   String    @default("06:00") // HH:MM به وقت تهران
  dayOfWeek   Int?      // 0=شنبه..6=جمعه (فقط WEEKLY)
  payload     String    @default("{}") // JSON ورودی مأموریت
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  lastJobId   String?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([enabled, nextRunAt])
}

model AzGrade {
  id     String    @id @default(cuid())
  code   String    @unique // "10" | "11" | "12"
  name   String
  order  Int       @default(0)
  tracks AzTrack[]
  questions AzQuestion[]
}

model AzTrack {
  id       String      @id @default(cuid())
  name     String // ریاضی‌فیزیک | علوم تجربی | علوم انسانی
  gradeId  String
  order    Int         @default(0)
  grade    AzGrade     @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  subjects AzSubject[]

  @@unique([gradeId, name])
}

model AzSubject {
  id        String      @id @default(cuid())
  name      String
  trackId   String
  order     Int         @default(0)
  track     AzTrack     @relation(fields: [trackId], references: [id], onDelete: Cascade)
  chapters  AzChapter[]
  questions AzQuestion[]
  videos    AzVideo[]
  sources   AzSource[]
  exams     AzExam[]
  documents AzDocument[]

  @@unique([trackId, name])
}

model AzChapter {
  id          String       @id @default(cuid())
  title       String
  subjectId   String
  order       Int          @default(0)
  targetCount Int          @default(30) // هدف بانک سؤال هر فصل — مبنای بدهی آزمون
  subject     AzSubject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions   AzQuestion[]

  @@unique([subjectId, order])
}

model AzSource {
  id          String    @id @default(cuid())
  subjectId   String
  gradeCode   String
  title       String
  url         String    @unique
  host        String    @default("")
  snippet     String    @default("")
  kind        String    @default("web") // web | pdf | video
  status      String    @default("DISCOVERED") // DISCOVERED | FETCHED | REJECTED
  credibility Int       @default(2) // 1..3 اعتبار منبع
  fetchedAt   DateTime?
  sourceJobId String?
  createdAt   DateTime  @default(now())
  subject     AzSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model AzVideo {
  id           String    @id @default(cuid())
  gradeCode    String
  subjectId    String
  chapterId    String?
  chapterTitle String    @default("")
  title        String
  url          String    @unique
  embedUrl     String
  provider     String    @default("aparat")
  status       String    @default("SEARCH_RESULT") // SEARCH_RESULT | VERIFIED | REJECTED
  sourceQuery  String    @default("")
  note         String?
  summary      String?
  verified     Boolean   @default(false)
  fileUrl      String? // لینک مستقیم فایل برای دید و درک مدل بینایی
  sourceJobId  String?
  createdAt    DateTime  @default(now())
  subject      AzSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model AzQuestion {
  id              String            @id @default(cuid())
  gradeId         String
  subjectId       String
  chapterId       String
  stem            String
  options         String // JSON آرایهٔ ۴ گزینه (SQLite: بدون Json)
  answerIndex     Int
  explanation     String            @default("")
  difficulty      String            @default("متوسط")
  difficultyScore Int               @default(3) // 1..5
  tags            String            @default("") // با «،» جدا شده
  goal            String            @default("") // هدف آموزشی
  contentHash     String            @default("")
  status          String            @default("PUBLISHED") // GENERATED | VALID | PUBLISHED | NEEDS_REVIEW | ARCHIVED
  createdBy       String            @default("agent") // agent | admin
  version         Int               @default(1)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  grade           AzGrade           @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  subject         AzSubject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapter         AzChapter         @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  examRefs        AzExamQuestion[]
  attemptAnswers  AzAttemptAnswer[]

  @@index([subjectId, status])
  @@index([chapterId])
  @@index([contentHash])
}

model AzExam {
  id             String           @id @default(cuid())
  title          String
  gradeCode      String
  subjectId      String
  config         String           @default("{}") // JSON: duration, mix, total, chapters…
  durationMin    Int              @default(30)
  description    String           @default("")
  status         String           @default("PUBLISHED") // DRAFT | PUBLISHED | ARCHIVED
  publishedAt    DateTime?
  createdAt      DateTime         @default(now())
  subject        AzSubject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  examQuestions  AzExamQuestion[]
  attempts       AzAttempt[]

  @@index([status, gradeCode])
}

model AzExamQuestion {
  id         String     @id @default(cuid())
  examId     String
  questionId String
  order      Int        @default(0)
  weight     Int        @default(1)
  exam       AzExam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question   AzQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers    AzAttemptAnswer[]

  @@unique([examId, questionId])
}

model AzAttempt {
  id          String            @id @default(cuid())
  examId      String
  studentId   String
  startedAt   DateTime          @default(now())
  submittedAt DateTime?
  deadlineAt  DateTime // اعتبارسنجی زمان از سمت سرور
  score       Int?
  total       Int?
  correct     Int?
  wrong       Int?
  blank       Int?
  exam        AzExam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers     AzAttemptAnswer[]

  @@index([studentId, submittedAt])
  @@index([examId])
}

model AzAttemptAnswer {
  id             String         @id @default(cuid())
  attemptId      String
  examQuestionId String
  questionId     String
  selectedIndex  Int?
  isCorrect      Boolean?
  answeredAt     DateTime       @default(now())
  attempt        AzAttempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  examQuestion   AzExamQuestion @relation(fields: [examQuestionId], references: [id], onDelete: Cascade)
  question       AzQuestion     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, examQuestionId])
}

model AzAgentJob {
  id          String        @id @default(cuid())
  command     String // GENERATE_QUESTIONS | COMPOSE_EXAM | RESEARCH_SOURCES | CURATE_VIDEOS | ANALYZE_TEACHERS | REVIEW_CONTENT | PROCESS_DOCUMENT
  gradeCode   String?
  subjectId   String?
  chapterId   String?
  documentId  String?
  targetCount Int           @default(0)
  generated   Int           @default(0)
  attempts    Int           @default(0)
  status      String        @default("QUEUED") // QUEUED | PLANNING | RUNNING | COMPLETED | FAILED | CANCELED
  notes       String?
  retryAfter  DateTime? // نوبت مجدد روی خطای گذرا — تا این لحظه صف مأموریت را برنمی‌دارد
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime      @default(now())
  steps       AzAgentStep[]

  @@index([status, retryAfter])
}

model AzAgentStep {
  id        String   @id @default(cuid())
  jobId     String
  name      String
  tool      String   @default("glm")
  purpose   String   @default("")
  status    String   @default("INFO") // INFO | OK | ERROR
  detail    String?
  createdAt DateTime @default(now())
  job       AzAgentJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

model AzAiLog {
  id            String   @id @default(cuid())
  model         String
  tool          String
  purpose       String
  ok            Boolean
  latencyMs     Int      @default(0)
  promptChars   Int      @default(0)
  responseChars Int      @default(0)
  error         String   @default("")
  httpStatus    Int?
  createdAt     DateTime @default(now())
}

model AzTeacherInsight {
  id          String   @id @default(cuid())
  teacherId   String?
  teacherName String
  subjectName String   @default("")
  score       Int      @default(0) // 0..100
  strengths   String   @default("")
  weaknesses  String   @default("")
  suitsFor    String   @default("") // برای چه دانش‌آموزانی مناسب است
  style       String   @default("") // شیوهٔ تدریس
  basedOn     Int      @default(0) // تعداد بازخورد مبنای تحلیل
  createdAt   DateTime @default(now())
}

model AzDocument {
  id            String    @id @default(cuid())
  title         String
  filename      String
  size          Int       @default(0)
  mime          String    @default("application/pdf")
  pages         Int?
  status        String    @default("QUEUED") // QUEUED | EXTRACTING | ANALYZING | READY | NEEDS_REVIEW | FAILED
  subjectId     String?
  gradeCode     String?
  extractedText String?
  summary       String?
  chaptersFound String? // JSON
  error         String?
  uploadedBy    String?
  createdAt     DateTime  @default(now())
  processedAt   DateTime?
  subject       AzSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
}
